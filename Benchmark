// NEXO CANVAS ANIMATION
// ═══════════════════════════════════════════════════════════════════
(function(){
  const cv=document.getElementById('nexoCanvas');
  if(!cv)return;
  const ctx=cv.getContext('2d');
  let W,H,pts=[];
  function resize(){
    W=cv.parentElement.clientWidth; H=cv.parentElement.clientHeight;
    cv.width=W; cv.height=H;
    initPts();
  }
  function initPts(){
    pts=[];
    const n=Math.floor((W*H)/14000);
    for(let i=0;i<n;i++){
      pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,r:Math.random()*1.5+.8});
    }
  }
  function draw(){
    ctx.clearRect(0,0,W,H);
    pts.forEach(p=>{
      p.x+=p.vx; p.y+=p.vy;
      if(p.x<0||p.x>W)p.vx*=-1;
      if(p.y<0||p.y>H)p.vy*=-1;
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle='#fff';
      ctx.fill();
    });
    for(let i=0;i<pts.length;i++){
      for(let j=i+1;j<pts.length;j++){
        const dx=pts[i].x-pts[j].x, dy=pts[i].y-pts[j].y;
        const d=Math.sqrt(dx*dx+dy*dy);
        if(d<100){
          ctx.beginPath();
          ctx.moveTo(pts[i].x,pts[i].y);
          ctx.lineTo(pts[j].x,pts[j].y);
          ctx.strokeStyle=`rgba(255,255,255,${(1-d/100)*.35})`;
          ctx.lineWidth=.7;
          ctx.stroke();
        }
      }
    }
    requestAnimationFrame(draw);
  }
  resize();
  window.addEventListener('resize',resize);
  draw();
})();

