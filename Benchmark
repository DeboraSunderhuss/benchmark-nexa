  {id:'fixo_carteira', lbl:'Valor fixo para gestão de carteira'},
  {id:'fixo_escopo', lbl:'Valor fixo para escopo específico'},
  {id:'por_processo', lbl:'Valor por processo'},
  {id:'nova_demanda', lbl:'Valor por nova demanda'},
  {id:'ato_fase', lbl:'Valor por ato/fase processual'},
  {id:'exito', lbl:'Honorário de êxito'},
  {id:'performance', lbl:'Remuneração vinculada à performance'},
];
const TIPOS = ['est','trab','cons','trib','outr'];
const TIPO_LBLS = ['Estratégico','Trab. Volume','Cons. Volume','Tributário','Outros'];

// Build checkbox matrix
const mb = document.getElementById('matrizBody');
MODELOS.forEach(m => {
  const tr = document.createElement('tr');
  let td = `<td>${m.lbl}</td>`;
  TIPOS.forEach(t => {
    td += `<td class="center"><div class="m-check" id="mc-${m.id}-${t}" onclick="mCheck(this,'${m.id}','${t}')"></div></td>`;
  });
  tr.innerHTML = td;
  mb.appendChild(tr);
});

// Build dropdown pred matrix
const pb = document.getElementById('predBody');
const predOpts = `<option value="">Selecione</option>${MODELOS.map(m=>`<option value="${m.id}">${m.lbl}</option>`).join('')}`;
TIPOS.forEach((t,i) => {
  const tr = document.createElement('tr');
  tr.innerHTML = `<td>${TIPO_LBLS[i]}</td><td colspan="5"><select class="m-select" id="pred-${t}" onchange="checkFases()">${predOpts}</select></td>`;
  pb.appendChild(tr);
});

// Check/radio matrix helpers
function mCheck(el,m,t){
  el.classList.toggle('sel');
  checkFases();
  prog();
}
function mRadio(el, group) {
  // group for row
  const row = el.closest('tr');
  row.querySelectorAll('.m-radio').forEach(r => r.classList.remove('sel'));
  el.classList.add('sel');
}

// Show fases if ato_fase selected
function checkFases(){
  let show = false;
  TIPOS.forEach(t => {
    const mc = document.getElementById(`mc-ato_fase-${t}`);
    const pr = document.getElementById(`pred-${t}`);
    if((mc&&mc.classList.contains('sel')) || (pr&&pr.value==='ato_fase')) show=true;
  });
  document.getElementById('q-fases-wrap').style.display = show ? 'block' : 'none';
}

// ═══════════════════════════════════════════════════════════════════
// OUTRO CONDITIONAL FIELDS
// ═══════════════════════════════════════════════════════════════════
// Checkbox-driven "outro" reveals
function setupOutroChk(name, condId) {
  document.querySelectorAll(`[name="${name}"]`).forEach(chk => {
    chk.addEventListener('change', function(){
      const outroChk = document.querySelector(`[name="${name}"][value^="outro"]`);
      const cond = document.getElementById(condId);
      if(cond) cond.classList.toggle('on', outroChk && outroChk.checked);
    });
  });
}
setupOutroChk('obj',  'cond-outro-obj');
setupOutroChk('comb', 'cond-outra-comb');
setupOutroChk('fase', 'cond-outro-fase');
setupOutroChk('crit', 'cond-outro-crit');
setupOutroChk('kpi',  'cond-outro-kpi');
setupOutroChk('lim',  'cond-outro-lim');

// Radio-driven "outro" reveals
function setupOutroRad(name, condId, triggerVal) {
  document.querySelectorAll(`[name="${name}"]`).forEach(r => {
    r.addEventListener('change', function(){
      const cond = document.getElementById(condId);
      if(cond) cond.classList.toggle('on', this.value === triggerVal);
    });
  });
}
setupOutroRad('acordoCond', 'cond-outro-ac',   'outro_ac');
setupOutroRad('indiceReaj', 'cond-outro-reaj', 'outro');
document.querySelectorAll('.opt').forEach(o => {
  const inp = o.querySelector('input');
  if(!inp) return;
  inp.addEventListener('change', function(){
    if(this.type==='radio'){
      document.querySelectorAll(`[name="${this.name}"]`).forEach(r=>r.closest('.opt')?.classList.remove('sel'));
    }
    this.checked ? o.classList.add('sel') : o.classList.remove('sel');
    prog();
  });
});

// Limit checkboxes
function setupLimit(name, max, limitId) {
  document.querySelectorAll(`[name="${name}"]`).forEach(chk => {
    chk.addEventListener('change', function(){
      const checked = document.querySelectorAll(`[name="${name}"]:checked`);
      if(checked.length > max){
        this.checked = false;
        this.closest('.opt')?.classList.remove('sel');
      }
      const note = document.getElementById(limitId);
      if(note) note.classList.toggle('on', document.querySelectorAll(`[name="${name}"]:checked`).length >= max);
      prog();
    });
  });
}
setupLimit('obj', 3, 'lim-obj');
setupLimit('crit', 3, 'lim-crit');
setupLimit('lim', 3, 'lim-lim');

// ═══════════════════════════════════════════════════════════════════
// SCALE
// ═══════════════════════════════════════════════════════════════════
function scl(id,btn,v){
  document.querySelectorAll(`#${id} .scale-btn`).forEach(b=>b.classList.remove('sel'));
  btn.classList.add('sel');
  document.getElementById(id).dataset.v=v;
  prog();
}

