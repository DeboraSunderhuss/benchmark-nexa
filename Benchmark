<script>
// ═══════════════════════════════════════════════════════════════════
// DEFAULT CONFIG
// ═══════════════════════════════════════════════════════════════════
const DEFAULT_CONFIG = {
  scores: {
    nEsc:          { ate3:3, '4a10':3, '11a20':2, '21a50':1, acima50:0 },
    perfInfluencia:{ sim:3, nao:0 },
    remunVar:      { ambos:3, bonus:2, penalidade:2, nao:0 },
    freqAval:      { trimestral:3, mensal:2, semestral:2, anual:1, nao:0 },
    cap:           { sim:3, nao:0 },
    indiceReaj:    { ipca:3, igpm:2, inpc:2, outro:1, nao:1 },
    autoNF:        { sim:3, em_impl:2, nao:0 },
    hibrido:       { sim:2, nao:0 },
    exitoPct:      { acima75:3, '51a75':2, '26a50':1, ate25:1, nao:0 },
  },
  thresholds: [
    { min:18, label:'Avançado',          cls:'bg' },
    { min:10, label:'Em desenvolvimento', cls:'ba' },
    { min:0,  label:'Básico',             cls:'br' },
  ],
  scoreLabels: {
    3:{ label:'Best practice', cls:'bg' },
    2:{ label:'Boa prática',   cls:'ba' },
    1:{ label:'Neutro',        cls:'ba' },
    0:{ label:'Gap',           cls:'br' },
  },
};

const SCORE_FIELD_NAMES = {
  nEsc:'Nº escritórios', perfInfluencia:'Performance → Remun.',
  remunVar:'Remun. variável', freqAval:'Freq. avaliação',
  cap:'CAP', indiceReaj:'Índice reajuste', autoNF:'Automação NF',
  hibrido:'Modelo híbrido', exitoPct:'Cobertura êxito',
};

let CFG = JSON.parse(JSON.stringify(DEFAULT_CONFIG));

function score(r){
  return Object.keys(CFG.scores).reduce((s,k)=>s+(CFG.scores[k][r[k]]||0),0);
}
function maxScore(){
  return Object.keys(CFG.scores).reduce((s,k)=>s+Math.max(...Object.values(CFG.scores[k])),0);
}
function classify(s){
  for(const t of CFG.thresholds){ if(s>=t.min) return t; }
  return CFG.thresholds[CFG.thresholds.length-1];
}

// ═══════════════════════════════════════════════════════════════════
// LABELS
// ═══════════════════════════════════════════════════════════════════
const LB = {
  porte:{ ate1bi:'Até R$1bi','1a5bi':'R$1–5bi','5a10bi':'R$5–10bi',acima10bi:'>R$10bi' },
  nEsc:{ ate3:'Até 3','4a10':'4–10','11a20':'11–20','21a50':'21–50',acima50:'>50' },
  modeloPred:{ hora:'Hora trabalhada',fixo_carteira:'Fixo carteira',fixo_escopo:'Fixo escopo',por_processo:'Por processo',nova_demanda:'Nova demanda',ato_fase:'Por ato/fase',exito:'Êxito',performance:'Performance' },
  remunVar:{ bonus:'Bônus',penalidade:'Penalidade',ambos:'Ambos',nao:'Não existe' },
  freqAval:{ mensal:'Mensal',trimestral:'Trimestral',semestral:'Semestral',anual:'Anual',nao:'Sem avaliação' },
  autoNF:{ sim:'Sim',em_impl:'Em implant.',nao:'Não' },
  indiceReaj:{ ipca:'IPCA',igpm:'IGP-M',inpc:'INPC',outro:'Outro',nao:'Sem reajuste' },
  orcamento:{ ate5M:'Até R$5M','5a20M':'R$5–20M','20a50M':'R$20–50M','50a100M':'R$50–100M',acima100M:'>R$100M' },
  exitoPct:{ nao:'Não utiliza',ate25:'Até 25%','26a50':'26–50%','51a75':'51–75%',acima75:'>75%' },
  exitoPerc:{ ate5:'Até 5%','6a10':'6–10%','11a20':'11–20%','21a30':'21–30%',acima30:'>30%',varia:'Varia' },
  acordoRemun:{ nao:'Não',fixo:'Fixo',var_saving:'Variável s/ saving',fixo_var:'Fixo + variável' },
  acordoCond:{ mesmo:'Mesmo escritório',outro_esc:'Outro escritório',empresa_esp:'Empresa especial.',hibrido_ac:'Híbrido',outro_ac:'Outro' },
  acordoPerc:{ ate5:'Até 5%','6a10':'6–10%','11a20':'11–20%','21a30':'21–30%',acima30:'>30%',varia:'Varia',na:'N/A' },
  modeloFut:{ hibrido:'Híbrido',performance:'Performance',fee_fase:'Por ato/fase',fee_processo:'Por processo',fee_fixo:'Fixo mensal' },
  objetivos:{ custo:'Redução de custo',previsibilidade:'Previsib. orçamentária',qualidade:'Qualidade técnica',escalabilidade:'Escalabilidade',passivo:'Redução de passivo',especializacao:'Especialização',velocidade:'Velocidade de atend.',outro_obj:'Outro' },
  criterios:{ red_custo:'Redução de custo',prev_orc:'Previsib. orçamentária',ctrl_fin:'Controle financeiro',alin_inc:'Alinham. de incentivos',comp_risco:'Compartil. de risco',facilidade:'Facilidade de gestão',volume:'Volume de demandas',complexidade:'Complexidade',criticidade:'Criticidade',historico:'Histórico da empresa',outro_crit:'Outro' },
  kpi:{ qualidade_tec:'Qualidade técnica',taxa_exito:'Taxa de êxito',sla:'SLA',prazo_resp:'Prazo de resposta',produtividade:'Produtividade',orcamento:'Cumprimento orçamento',economia:'Economia gerada',red_contingencias:'Redução contingências',satisfacao_int:'Satisfação interna',outro_kpi:'Outro' },
  limitacoes:{ baixa_prev:'Baixa previsibilidade',complexidade:'Complexidade de gestão',auditoria:'Dificuldade auditoria',inc_desalin:'Incentivos desalin.',exc_horas:'Incentiva excesso horas',aum_volume:'Incentiva volume',sem_efic:'Sem incentivo eficiência',qual_inc:'Qualidade inconsistente',outro_lim:'Outro' },
  TIPOS:{ est:'Estratégico',trab:'Trab. Volume',cons:'Cons. Volume',trib:'Tributário',outr:'Outros' },
  MODELOS_IDS:['hora','fixo_carteira','fixo_escopo','por_processo','nova_demanda','ato_fase','exito','performance'],
  MODELOS_LBLS:['Hora trab.','Fixo carteira','Fixo escopo','Por processo','Nova demanda','Por ato/fase','Êxito','Performance'],
};
function lb(t,v){ return (LB[t]&&LB[t][v])||v||'—'; }

// ═══════════════════════════════════════════════════════════════════
// PALETA NEXA
// ═══════════════════════════════════════════════════════════════════
const P=['#1E3A28','#4A7459','#7FA88A','#C2D9C8','#C4710F','#8C6E4B','#4A4A4A','#2D6A4F'];
const CD={
  plugins:{legend:{labels:{font:{family:'Plus Jakarta Sans',size:10},boxWidth:9,padding:9}},
           tooltip:{titleFont:{family:'Plus Jakarta Sans'},bodyFont:{family:'Plus Jakarta Sans'}}},
  responsive:true, maintainAspectRatio:false
};
const CH={};
function bar(id,labels,data,opts={}){
  const ctx=document.getElementById(id); if(!ctx)return;
  if(CH[id])CH[id].destroy();
  CH[id]=new Chart(ctx,{type:'bar',
    data:{labels,datasets:[{data,backgroundColor:opts.colors||P,borderRadius:4,borderSkipped:false}]},
    options:{...CD,indexAxis:opts.h?'y':'x',
      plugins:{...CD.plugins,legend:{display:false}},
      scales:{x:{ticks:{font:{family:'Plus Jakarta Sans',size:10}},grid:{display:false}},
              y:{ticks:{font:{family:'Plus Jakarta Sans',size:10}},grid:{color:'rgba(0,0,0,.04)'}}}}});
}
function pie(id,labels,data,opts={}){
  const ctx=document.getElementById(id); if(!ctx)return;
  if(CH[id])CH[id].destroy();
  CH[id]=new Chart(ctx,{type:opts.d?'doughnut':'pie',
    data:{labels,datasets:[{data,backgroundColor:opts.colors||P,borderWidth:2,borderColor:'#fff'}]},
    options:{...CD,cutout:opts.d?'50%':0}});
}
function barGroup(id,labels,datasets,opts={}){
  const ctx=document.getElementById(id); if(!ctx)return;
  if(CH[id])CH[id].destroy();
  CH[id]=new Chart(ctx,{type:'bar',
    data:{labels,datasets},
    options:{...CD,indexAxis:opts.h?'y':'x',
      scales:{x:{ticks:{font:{family:'Plus Jakarta Sans',size:9}},grid:{display:false},stacked:false},
              y:{ticks:{font:{family:'Plus Jakarta Sans',size:9}},grid:{color:'rgba(0,0,0,.04)'}}}}});
}

// ═══════════════════════════════════════════════════════════════════
// DATA HELPERS
// ═══════════════════════════════════════════════════════════════════
function cnt(d,f){const m={};d.forEach(r=>{const v=r[f];if(v)m[v]=(m[v]||0)+1;});return m;}
function cntA(d,f){const m={};d.forEach(r=>{(r[f]||[]).forEach(v=>{m[v]=(m[v]||0)+1;});});return m;}
function pct(n,t){return t?Math.round(n/t*100):0;}
function avg(arr){ return arr.length?Math.round(arr.reduce((a,b)=>a+b,0)/arr.length*10)/10:0; }
function kbarHtml(items,n){
  return items.map(([lbl,cnt2])=>{
    const p=pct(cnt2,n);
    const col=p>=60?'var(--se)':p>=30?'var(--sp)':'var(--sm)';
    return `<div class="kr"><span class="kl">${lbl}</span><div class="kb"><div class="kf" style="width:${p}%;background:${col}"></div></div><span class="kv" style="color:${col}">${p}%</span></div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════════════════
// MAIN RENDER
// ═══════════════════════════════════════════════════════════════════
function render(){
  const raw=JSON.parse(localStorage.getItem('bench_nexa_v2')||'[]');
  const n=raw.length;
  document.getElementById('st1').textContent=n;
  const mx=maxScore();

  if(n>0){
    const hibN=raw.filter(r=>r.hibrido==='sim').length;
    const exitoN=raw.filter(r=>r.exitoPct&&r.exitoPct!=='nao').length;
    const sats=raw.map(r=>parseInt(r.satisfacao)||0).filter(s=>s>0);
    const perfN=raw.filter(r=>r.perfInfluencia==='sim').length;
    const mc=cnt(raw,'modeloPred'); // key is from pred dropdown
    const topMod=Object.entries(mc).sort((a,b)=>b[1]-a[1])[0];

    document.getElementById('st2').textContent=pct(hibN,n)+'%';
    document.getElementById('st3').textContent=pct(exitoN,n)+'%';
    document.getElementById('st4').textContent=sats.length?avg(sats)+'/5':'—';
    document.getElementById('st5').textContent=pct(perfN,n)+'%';
    document.getElementById('k1').textContent=n;
    document.getElementById('k3').textContent=pct(exitoN,n)+'%';
    document.getElementById('k4').textContent=sats.length?avg(sats)+'/5':'—';
    if(topMod){
      const predLbl=lb('modeloPred',topMod[0])||topMod[0];
      document.getElementById('k2').textContent=predLbl;
    }
  }

  n===0 ? showEmpty() : renderAll(raw,n,mx);
  renderGabarito();
}

function showEmpty(){
  document.getElementById('empty-visao').style.display='block';
  document.getElementById('content-visao').style.display='none';
}

function renderAll(d,n,mx){
  document.getElementById('empty-visao').style.display='none';
  document.getElementById('content-visao').style.display='block';
  rVisao(d,n); rModelos(d,n); rExito(d,n); rPerf(d,n);
  rAcordos(d,n); rSatisfacao(d,n); rGov(d,n); rTable(d,mx);
}

// ── VISÃO GERAL ──────────────────────────────────────────────────
function rVisao(d,n){
  const pk=['ate1bi','1a5bi','5a10bi','acima10bi'];
  pie('cPorte',pk.map(k=>lb('porte',k)),pk.map(k=>cnt(d,'porte')[k]||0),{d:true,colors:P});

  const ek=['ate3','4a10','11a20','21a50','acima50'];
  bar('cEsc',ek.map(k=>lb('nEsc',k)),ek.map(k=>cnt(d,'nEsc')[k]||0));

  // Carteira média
  const tipos=['estrategico','trabalhista','consumidor','tributario','outros'];
  const tipoLbls=['Estratégico','Trab. Volume','Cons. Volume','Tributário','Outros'];
  const avgs=tipos.map(t=>{
    const vals=d.map(r=>r.carteira?r.carteira[t]||0:0).filter(v=>v>0);
    return vals.length?Math.round(vals.reduce((a,b)=>a+b,0)/vals.length):0;
  });
  bar('cCarteira',tipoLbls,avgs,{colors:P});

  // Objetivos
  const ob=cntA(d,'objetivos');
  const obKeys=Object.keys(LB.objetivos);
  const obItems=obKeys.map(k=>[lb('objetivos',k),ob[k]||0]).sort((a,b)=>b[1]-a[1]);
  document.getElementById('wObjetivos').innerHTML=kbarHtml(obItems,n);
}

// ── MODELOS ───────────────────────────────────────────────────────
function rModelos(d,n){
  const TIPOS_K=['est','trab','cons','trib','outr'];
  const TIPOS_L=['Estratégico','Trab. Vol.','Cons. Vol.','Tributário','Outros'];
  const MOD_IDS=LB.MODELOS_IDS;
  const MOD_LBL=LB.MODELOS_LBLS;

  // Heat map: modelo x tipo, % de empresas que marcaram
  const tbl=document.getElementById('heatModelos');
  let html=`<thead><tr><th>Modelo</th>${TIPOS_L.map(l=>`<th>${l}</th>`).join('')}</tr></thead><tbody>`;
  MOD_IDS.forEach((m,i)=>{
    html+=`<tr><td>${MOD_LBL[i]}</td>`;
    TIPOS_K.forEach(t=>{
      const cnt2=d.filter(r=>r.matrizModelos&&(r.matrizModelos[t]||[]).includes(m)).length;
      const p=pct(cnt2,n);
      const cls=p===0?'hc0':p<=20?'hc1':p<=40?'hc2':p<=60?'hc3':p<=80?'hc4':'hc5';
      html+=`<td><div class="heat-cell ${cls}">${p>0?p+'%':'—'}</div></td>`;
    });
    html+=`</tr>`;
  });
  html+=`</tbody>`;
  tbl.innerHTML=html;

  // Pred agrupado: para cada tipo, distribuição dos modelos
  const predDatasets=TIPOS_K.map((t,ti)=>{
    const counts=MOD_IDS.map(m=>{
      return d.filter(r=>r.modeloPred&&r.modeloPred[t]===m).length;
    });
    return {label:TIPOS_L[ti],data:counts,backgroundColor:P[ti]};
  });
  barGroup('cPredAgrupado',MOD_LBL,predDatasets);

  // Híbrido
  const hib=cnt(d,'hibrido');
  pie('cHibrido',['Sim, combina','Não combina'],[hib['sim']||0,hib['nao']||0],
    {d:true,colors:[P[0],P[2]]});

  // Combinações
  const comb=cntA(d,'combinacoes');
  const combKeys=['hora_exito','fixo_exito','fixo_perf','outra_comb'];
  const combLbls=['Hora trab. + êxito','Fixo + êxito','Fixo + performance','Outra'];
  const combItems=combKeys.map((k,i)=>[combLbls[i],comb[k]||0]).sort((a,b)=>b[1]-a[1]);
  document.getElementById('wCombinacoes').innerHTML=kbarHtml(combItems,n);

  // Critérios
  const cr=cntA(d,'criterios');
  const crKeys=Object.keys(LB.criterios);
  const crItems=crKeys.map(k=>[lb('criterios',k),cr[k]||0]).sort((a,b)=>b[1]-a[1]);
  document.getElementById('wCriterios').innerHTML=kbarHtml(crItems,n);

  // Futuro
  const fk=['hibrido','performance','fee_fase','fee_processo','fee_fixo'];
  const fv=cnt(d,'modeloFut');
  bar('cFuturo',fk.map(k=>lb('modeloFut',k)),fk.map(k=>fv[k]||0),
    {colors:['#1E3A28','#4A7459','#7FA88A','#C4710F','#8C6E4B']});
}

// ── ÊXITO ─────────────────────────────────────────────────────────
function rExito(d,n){
  const TIPOS_K=['est','trab','cons','trib','outr'];
  const TIPOS_L=['Estratégico','Trab. Volume','Cons. Volume','Tributário','Outros'];

  // Heat map êxito por tipo (Sim/Não por linha de matriz)
  const tbl=document.getElementById('heatExito');
  let html=`<thead><tr><th>Tipo de contencioso</th><th>Sim (%)</th><th>Não (%)</th></tr></thead><tbody>`;
  TIPOS_K.forEach((t,i)=>{
    const simN=d.filter(r=>{
      if(!r.exitoPorTipo) return false;
      const tr2=r.exitoPorTipo;
      // look for match by tipo key
      const key=Object.keys(tr2).find(k=>k===t);
      return key && tr2[key]==='sim';
    }).length;
    const naoN=n-simN;
    const ps=pct(simN,n); const pn=pct(naoN,n);
    const cls=ps===0?'hc0':ps<=25?'hc1':ps<=50?'hc2':ps<=75?'hc3':'hc5';
    html+=`<tr><td>${TIPOS_L[i]}</td>
      <td><div class="heat-cell ${cls}">${ps>0?ps+'%':'—'}</div></td>
      <td><div class="heat-cell hc0">${pn>0?pn+'%':'—'}</div></td></tr>`;
  });
  html+=`</tbody>`;
  tbl.innerHTML=html;

  // Cobertura
  const epk=['nao','ate25','26a50','51a75','acima75'];
  const epv=cnt(d,'exitoPct');
  pie('cExitoPct',epk.map(k=>lb('exitoPct',k)),epk.map(k=>epv[k]||0),
    {colors:['#4A4A4A','#C2D9C8','#7FA88A','#4A7459','#1E3A28']});

  // Percentual praticado
  const eppk=['ate5','6a10','11a20','21a30','acima30','varia'];
  const eppv=cnt(d,'exitoPerc');
  bar('cExitoPerc',eppk.map(k=>lb('exitoPerc',k)),eppk.map(k=>eppv[k]||0),
    {colors:['#C2D9C8','#7FA88A','#4A7459','#1E3A28','#2D6A4F','#8C6E4B']});
}

