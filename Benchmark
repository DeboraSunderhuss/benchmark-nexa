// ── TABLE ─────────────────────────────────────────────────────────
function rTable(d,mx){
  document.getElementById('rtbody').innerHTML=d.map(r=>{
    const s=score(r); const cl=classify(s);
    const predValues=r.modeloPred?Object.values(r.modeloPred).filter(Boolean):[];
    const uniq=[...new Set(predValues)];
    const predChips=uniq.slice(0,2).map(v=>`<span class="chip">${lb('modeloPred',v)}</span>`).join('');
    return `<tr>
      <td><strong style="font-family:var(--fh)">${r.empresa}</strong><br><span style="font-size:.7rem;color:var(--sm)">${r.cargo||''}</span></td>
      <td>${lb('porte',r.porte)}</td>
      <td>${lb('nEsc',r.nEsc)}</td>
      <td>${predChips||'—'}</td>
      <td>${r.hibrido==='sim'?'<span class="bdg bg">Sim</span>':'<span class="bdg br">Não</span>'}</td>
      <td>${lb('exitoPct',r.exitoPct)||'—'}</td>
      <td>${r.perfInfluencia==='sim'?'<span class="bdg bg">Sim</span>':'<span class="bdg br">Não</span>'}</td>
      <td>${r.satisfacao?r.satisfacao+'/5':'—'}</td>
      <td><strong style="font-family:var(--fh)">${s}/${mx}</strong></td>
      <td><span class="bdg ${cl.cls}">${cl.label}</span></td>
    </tr>`;
  }).join('');
}

// ── GABARITO ──────────────────────────────────────────────────────
function renderGabarito(){
  const mx=maxScore();
  document.getElementById('gabWrap').innerHTML=Object.entries(CFG.scores).map(([f,opts])=>`
    <div class="gab-card"><h3>${SCORE_FIELD_NAMES[f]||f}</h3>
    <table class="gt"><thead><tr><th>Resposta</th><th style="width:80px;text-align:center">Pontuação</th><th>Classificação</th></tr></thead>
    <tbody>${Object.entries(opts).sort((a,b)=>b[1]-a[1]).map(([v,pts])=>{
      const sl=CFG.scoreLabels[pts]||{label:'—',cls:'bb'};
      return `<tr><td style="font-weight:500">${lb(f,v)||v}</td><td style="text-align:center"><span class="bdg ${sl.cls}">${pts}</span></td><td><span class="bdg ${sl.cls}">${sl.label}</span></td></tr>`;
    }).join('')}</tbody></table></div>`).join('');
}

// ═══════════════════════════════════════════════════════════════════
// CONFIG PANEL UI
// ═══════════════════════════════════════════════════════════════════
function toggleCfg(){
  document.getElementById('cfgPanel').classList.toggle('open');
  document.getElementById('cfgArrow').classList.toggle('open');
}
function buildCfgUI(){
  const sg=document.getElementById('cfgGrid');
  sg.innerHTML='';
  Object.entries(CFG.scores).forEach(([f,opts])=>{
    Object.entries(opts).forEach(([v,pts])=>{
      const sl=CFG.scoreLabels[pts]||{label:'',cls:'bb'};
      const div=document.createElement('div'); div.className='cfg-row';
      div.innerHTML=`<div class="cfg-lbl">${SCORE_FIELD_NAMES[f]||f}<small>${lb(f,v)||v}</small></div>
        <span class="bdg ${sl.cls} cfg-cls">${sl.label}</span>
        <input class="cfg-inp" type="number" min="0" max="5" value="${pts}" data-field="${f}" data-val="${v}" oninput="updCfgLbl(this)">`;
      sg.appendChild(div);
    });
  });
  const tg=document.getElementById('cfgThresh');
  tg.innerHTML='';
  CFG.thresholds.forEach((t,i)=>{
    const div=document.createElement('div'); div.className='cfg-row';
    div.innerHTML=`<div class="cfg-lbl">Faixa <span class="bdg ${t.cls}">${t.label}</span></div>
      <span style="font-size:.72rem;color:var(--graf)">≥</span>
      <input class="cfg-inp" type="number" min="0" max="99" value="${t.min}" data-thresh="${i}" style="width:44px">
      <input type="text" value="${t.label}" data-thresh-lbl="${i}" style="width:100px;font-family:var(--fb);font-size:.76rem;border:1.5px solid var(--brd);border-radius:6px;padding:.28rem .5rem;outline:none;background:var(--sf)">`;
    tg.appendChild(div);
  });
}
function updCfgLbl(inp){
  const pts=parseInt(inp.value)||0;
  const sl=CFG.scoreLabels[pts]||{label:'?',cls:'bb'};
  const b=inp.previousElementSibling;
  b.className=`bdg ${sl.cls} cfg-cls`; b.textContent=sl.label;
}
function applyConfig(){
  document.querySelectorAll('.cfg-inp[data-field]').forEach(i=>{
    CFG.scores[i.dataset.field][i.dataset.val]=parseInt(i.value)||0;
  });
  document.querySelectorAll('.cfg-inp[data-thresh]').forEach(i=>{
    CFG.thresholds[parseInt(i.dataset.thresh)].min=parseInt(i.value)||0;
  });
  document.querySelectorAll('input[data-thresh-lbl]').forEach(i=>{
    CFG.thresholds[parseInt(i.dataset.threshLbl)].label=i.value||'—';
  });
  localStorage.setItem('bench_nexa_cfg_v2',JSON.stringify(CFG));
  buildCfgUI(); render();
  const btn=document.querySelector('.cfg-apply');
  btn.textContent='✓ Aplicado!'; btn.style.background='var(--gr)';
  setTimeout(()=>{btn.textContent='Aplicar configurações';btn.style.background='';},1600);
}
function resetConfig(){
  if(confirm('Restaurar padrões?')){
    CFG=JSON.parse(JSON.stringify(DEFAULT_CONFIG));
    localStorage.removeItem('bench_nexa_cfg_v2');
    buildCfgUI(); render();
  }
}
function loadConfig(){
  const s=localStorage.getItem('bench_nexa_cfg_v2');
  if(s)try{CFG=JSON.parse(s);}catch(e){}
}

// ═══════════════════════════════════════════════════════════════════
// UI HELPERS
// ═══════════════════════════════════════════════════════════════════
function tab(id,btn){
  document.querySelectorAll('.tp').forEach(p=>p.classList.remove('on'));
  document.querySelectorAll('.tbtn').forEach(b=>b.classList.remove('on'));
  document.getElementById('tab-'+id).classList.add('on');
  btn.classList.add('on');
}
function openMo(){document.getElementById('modal').classList.add('on');}
function closeMo(){document.getElementById('modal').classList.remove('on');}
function doImport(){
  try{
    const p=JSON.parse(document.getElementById('importTA').value.trim());
    if(!Array.isArray(p))throw new Error('Deve ser um array JSON');
    const e=JSON.parse(localStorage.getItem('bench_nexa_v2')||'[]');
    localStorage.setItem('bench_nexa_v2',JSON.stringify([...e,...p]));
    closeMo(); render();
    alert(p.length+' resposta(s) importada(s) com sucesso.');
  }catch(err){alert('JSON inválido.\n\n'+err.message);}
}
function clearD(){
  if(confirm('Remover todas as respostas? Esta ação não pode ser desfeita.')){
    localStorage.removeItem('bench_nexa_v2'); render();
  }
}
function exportData(){
  const d=localStorage.getItem('bench_nexa_v2')||'[]';
  const a=document.createElement('a');
  a.href='data:application/json;charset=utf-8,'+encodeURIComponent(d);
  a.download='benchmark_nexa_respostas.json';
  a.click();
}

// ═══════════════════════════════════════════════════════════════════
// GOOGLE SHEETS INTEGRATION
// ═══════════════════════════════════════════════════════════════════
const SHEETS_URL = 'https://script.google.com/macros/s/AKfycbwAGievduiPxsCP3V4NnZ3DkLqtNY6gyhFL_IiL3zw7s8epixuUiWkvtAxtZX86TYyT/exec';

function fetchFromSheets(){
  const indicator = document.getElementById('syncIndicator');
  if(indicator){ indicator.textContent = '↻ Atualizando...'; indicator.style.color='rgba(255,255,255,.5)'; }

  fetch(SHEETS_URL)
    .then(r => r.json())
    .then(data => {
      if(!Array.isArray(data) || data.length === 0){
        if(indicator){ indicator.textContent = '✓ Sem dados ainda'; indicator.style.color='rgba(255,255,255,.4)'; }
        render(); return;
      }
      // Merge with any local data, deduplicate by id
      const local = JSON.parse(localStorage.getItem('bench_nexa_v2')||'[]');
      const allById = {};
      [...local, ...data].forEach(r => { if(r.id) allById[r.id] = r; });
      const merged = Object.values(allById);
      localStorage.setItem('bench_nexa_v2', JSON.stringify(merged));
      if(indicator){ indicator.textContent = `✓ ${merged.length} resposta(s) · atualizado agora`; indicator.style.color='rgba(255,255,255,.45)'; }
      render();
    })
    .catch(() => {
      if(indicator){ indicator.textContent = '⚠ Sem conexão — usando dados locais'; indicator.style.color='rgba(255,165,0,.6)'; }
      render();
    });
}

// Auto-refresh every 2 minutes
setInterval(fetchFromSheets, 120000);
window.addEventListener('load',()=>{loadConfig();buildCfgUI();fetchFromSheets();});
</script>
