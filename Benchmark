function tog(id,v){ document.getElementById(id)?.classList.toggle('on', v==='sim'); }

// ═══════════════════════════════════════════════════════════════════
// PCT TOTAL
// ═══════════════════════════════════════════════════════════════════
function calcPct(){
  const ids=['estrategico','trabalhista','consumidor','tributario','outros'];
  const total = ids.reduce((s,id)=>{ const v=parseInt(document.getElementById('pct-'+id)?.value)||0; return s+v; },0);
  const el = document.getElementById('pctTotal');
  el.textContent = total+'%';
  el.className = 'tot-val'+(total===100?' ok':total>100?' over':'');
  prog();
}

// ═══════════════════════════════════════════════════════════════════
// LGPD
// ═══════════════════════════════════════════════════════════════════
function lgpdTog(){
  const ok = document.getElementById('lgpdChk').checked;
  document.getElementById('lgpdLbl').classList.toggle('sel',ok);
  document.getElementById('btnEnviar').disabled = !ok;
  document.getElementById('err-lgpd').classList.remove('on');
  prog();
}

// ═══════════════════════════════════════════════════════════════════
// PROGRESS
// ═══════════════════════════════════════════════════════════════════
function radio(n){ const e=document.querySelector(`[name="${n}"]:checked`); return e?e.value:null; }
function checks(n){ return[...document.querySelectorAll(`[name="${n}"]:checked`)].map(e=>e.value); }

function prog(){
  let f=0, t=0;
  // lgpd
  t++; if(document.getElementById('lgpdChk').checked) f++;
  // text
  ['empresa','cargo','segmento'].forEach(id=>{ t++; if(document.getElementById(id)?.value.trim()) f++; });
  // radios
  ['t2','t3','porte','nEsc','hibrido','perfInfluencia','remunVar','freqAval','cap','acordoRemun','indiceReaj','autoNF','mudanca','modeloFut'].forEach(n=>{ t++; if(radio(n)) f++; });
  // pct
  t++; if(document.getElementById('pctTotal')?.textContent==='100%') f++;
  const pct = Math.round(f/t*100);
  document.getElementById('pBar').style.width=pct+'%';
  document.getElementById('pPct').textContent=pct+'%';
}

// ═══════════════════════════════════════════════════════════════════
// COLLECT + SUBMIT
// ═══════════════════════════════════════════════════════════════════
function validate(){
  let ok=true;
  if(!document.getElementById('lgpdChk').checked){ document.getElementById('err-lgpd').classList.add('on'); ok=false; }
  [['empresa','text'],['cargo','text'],['t2','radio'],['perfInfluencia','radio']].forEach(([f,tp])=>{
    const v=tp==='text'?document.getElementById(f)?.value.trim():radio(f);
    const e=document.getElementById('err-'+f);
    if(!v){if(e)e.classList.add('on');ok=false;}else{if(e)e.classList.remove('on');}
  });
  return ok;
}

function collectMatrix(){
  const res={};
  TIPOS.forEach(t=>{
    res[t]=MODELOS.filter(m=>document.getElementById(`mc-${m.id}-${t}`)?.classList.contains('sel')).map(m=>m.id);
  });
  return res;
}
function collectPred(){
  const res={};
  TIPOS.forEach(t=>{ const s=document.getElementById(`pred-${t}`); if(s)res[t]=s.value||''; });
  return res;
}
function collectExitoRows(){
  const res={};
  ['est','trab','cons','trib','outr'].forEach(t=>{
    const simEl=document.querySelector(`#exito-${t}`);
    // find radio in same row
    const rows=document.querySelectorAll('.matrix tbody tr');
    rows.forEach(tr=>{
      const radios=tr.querySelectorAll('.m-radio');
      if(radios.length===2){
        const lbl=tr.querySelector('td:first-child')?.textContent||'';
        const key=lbl.toLowerCase().includes('estrat')?'est':lbl.toLowerCase().includes('trab')?'trab':lbl.toLowerCase().includes('cons')?'cons':lbl.toLowerCase().includes('trib')?'trib':'outr';
        res[key]=radios[0].classList.contains('sel')?'sim':radios[1].classList.contains('sel')?'nao':'';
      }
    });
  });
  return res;
}

function enviar(){
  if(!validate()){
    document.querySelector('.err-msg.on')?.scrollIntoView({behavior:'smooth',block:'center'});
    return;
  }
  const d={
    id:Date.now(), ts:new Date().toISOString(), lgpdConsent:true,
    empresa:document.getElementById('empresa').value.trim(),
    cargo:document.getElementById('cargo').value.trim(),
    t2:radio('t2'), t3:radio('t3'),
    segmento:document.getElementById('segmento').value.trim(),
    porte:radio('porte'), processos:radio('processos'), nEsc:radio('nEsc'),
    carteira:{
      estrategico:parseInt(document.getElementById('pct-estrategico')?.value)||0,
      trabalhista:parseInt(document.getElementById('pct-trabalhista')?.value)||0,
      consumidor:parseInt(document.getElementById('pct-consumidor')?.value)||0,
      tributario:parseInt(document.getElementById('pct-tributario')?.value)||0,
      outros:parseInt(document.getElementById('pct-outros')?.value)||0,
    },
    objetivos:checks('obj'),
    matrizModelos:collectMatrix(),
    modeloPred:collectPred(),
    hibrido:radio('hibrido'), combinacoes:checks('comb'),
    fases:checks('fase'),
    criterios:checks('crit'),
    satisfacao:document.getElementById('sc12')?.dataset.v||null,
    exitoPorTipo:collectExitoRows(),
    exitoPct:radio('exitoPct'), exitoPeso:radio('exitoPeso'),
    exitoPerc:radio('exitoPerc'),
    perfInfluencia:radio('perfInfluencia'),
    kpis:checks('kpi'),
    remunVar:radio('remunVar'), freqAval:radio('freqAval'),
    acordoRemun:radio('acordoRemun'), acordoPerc:radio('acordoPerc'), acordoCond:radio('acordoCond'),
    cap:radio('cap'), capNivel:checks('capNivel'),
    indiceReaj:radio('indiceReaj'), autoNF:radio('autoNF'), orcamento:radio('orcamento'),
    limitacoes:checks('lim'),
    limitacoesOutro:document.getElementById('outro-lim-txt')?.value||'',
    objetivosOutro:document.getElementById('outro-obj-txt')?.value||'',
    criteriosOutro:document.getElementById('outro-crit-txt')?.value||'',
    kpisOutro:document.getElementById('outro-kpi-txt')?.value||'',
    fasesOutro:document.getElementById('outro-fase-txt')?.value||'',
    combinacoesOutro:document.getElementById('outra-comb-txt')?.value||'',
    acordoCondOutro:document.getElementById('outro-ac-txt')?.value||'',
    indiceReajOutro:document.getElementById('outro-reaj-txt')?.value||'',
    mudanca:radio('mudanca'), mudancaDesc:document.getElementById('mudancaDesc')?.value||'',
    modeloFut:radio('modeloFut'),
    boasPraticas:document.getElementById('boasPraticas')?.value||'',
  };

  // Flatten carteira for Google Sheets columns
  const flat = {
    ...d,
    cart_estrategico: d.carteira?.estrategico||0,
    cart_trabalhista:  d.carteira?.trabalhista||0,
    cart_consumidor:   d.carteira?.consumidor||0,
    cart_tributario:   d.carteira?.tributario||0,
    cart_outros:       d.carteira?.outros||0,
    // flatten matriz modelos
    modelos_est:  (d.matrizModelos?.est||[]).join(', '),
    modelos_trab: (d.matrizModelos?.trab||[]).join(', '),
    modelos_cons: (d.matrizModelos?.cons||[]).join(', '),
    modelos_trib: (d.matrizModelos?.trib||[]).join(', '),
    modelos_outr: (d.matrizModelos?.outr||[]).join(', '),
    // flatten modelo pred
    pred_est:  d.modeloPred?.est||'',
    pred_trab: d.modeloPred?.trab||'',
    pred_cons: d.modeloPred?.cons||'',
    pred_trib: d.modeloPred?.trib||'',
    pred_outr: d.modeloPred?.outr||'',
    // flatten exito por tipo
    exito_est:  d.exitoPorTipo?.est||'',
    exito_trab: d.exitoPorTipo?.trab||'',
    exito_cons: d.exitoPorTipo?.cons||'',
    exito_trib: d.exitoPorTipo?.trib||'',
    exito_outr: d.exitoPorTipo?.outr||'',
    // arrays to string
    objetivos:    (d.objetivos||[]).join(', '),
    combinacoes:  (d.combinacoes||[]).join(', '),
    fases:        (d.fases||[]).join(', '),
    criterios:    (d.criterios||[]).join(', '),
    kpis:         (d.kpis||[]).join(', '),
    limitacoes:   (d.limitacoes||[]).join(', '),
    capNivel:     (d.capNivel||[]).join(', '),
  };

  // Save locally as backup
  const saved=JSON.parse(localStorage.getItem('bench_nexa_v2')||'[]');
  saved.push(d);
  localStorage.setItem('bench_nexa_v2',JSON.stringify(saved));

  // Send to Google Sheets automatically
  const SHEETS_URL = 'https://script.google.com/macros/s/AKfycbwAGievduiPxsCP3V4NnZ3DkLqtNY6gyhFL_IiL3zw7s8epixuUiWkvtAxtZX86TYyT/exec';
  fetch(SHEETS_URL, {
    method: 'POST',
    mode: 'no-cors',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(flat)
  }).catch(()=>{}); // silently ignore errors — data is still saved locally

  // Email notification
  const emp=d.empresa||'(não informado)';
  const dt=new Date(d.ts).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'});
  const bdy=[
    `Benchmark Nexa: Nova resposta`,``,`Empresa: ${emp}`,`Cargo: ${d.cargo}`,`Data: ${dt}`,``,
    `CARTEIRA:`,
    `Estratégico: ${d.carteira.estrategico}%`,`Trabalhista volume: ${d.carteira.trabalhista}%`,
    `Consumidor volume: ${d.carteira.consumidor}%`,`Tributário: ${d.carteira.tributario}%`,`Outros: ${d.carteira.outros}%`,``,
    `PERFORMANCE → REMUNERAÇÃO: ${d.perfInfluencia==='sim'?'Sim':'Não'}`,
    `Remun. variável: ${d.remunVar||'(não respondido)'}`,
    `Freq. avaliação: ${d.freqAval||'(não respondido)'}`,``,
    `HONORÁRIO DE ÊXITO:`,`% carteira com êxito: ${d.exitoPct||'(não respondido)'}`,
    `% praticado: ${d.exitoPerc||'(não respondido)'}`,``,
    `ACORDOS: ${d.acordoRemun||'(não respondido)'}`,`Condutor: ${d.acordoCond||'(não respondido)'}`,``,
    d.boasPraticas?`BOAS PRÁTICAS: ${d.boasPraticas}`:'',``,
    `---`,`Gerado automaticamente pelo formulário de benchmark Nexa.`
  ].filter(l=>l!==undefined).join('\n');

  const mailto=`mailto:debora@nexaeg.com.br?subject=${encodeURIComponent('[Benchmark Nexa] Nova resposta: '+emp)}&body=${encodeURIComponent(bdy)}`;
  const fr=document.createElement('iframe'); fr.style.display='none'; fr.src=mailto;
  document.body.appendChild(fr);
  setTimeout(()=>{
    const el=document.getElementById('emailLink');
    const fp=document.getElementById('emailFallback');
    if(el&&fp){el.href=mailto;fp.style.display='block';}
    fr.remove();
  },2000);

  // Show success
  document.getElementById('submitArea').style.display='none';
  document.querySelectorAll('.sc').forEach(c=>c.style.display='none');
  document.querySelector('.lgpd').style.display='none';
  document.getElementById('successScreen').classList.add('on');
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>
