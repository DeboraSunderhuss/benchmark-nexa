<!DOCTYPE pesquisa.html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel de Análise · Benchmark Remuneração de Escritórios · Nexa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root {
  --se:#1E3A28; --sp:#4A7459; --sm:#7FA88A; --sc:#C2D9C8; --sf:#EDF4EF;
  --ow:#F5F3F0; --ambar:#C4710F; --amb-lt:#FBF0E0;
  --preto:#1A1A1A; --graf:#4A4A4A; --brd:#DDE8DF;
  --gr:#2D6A4F; --gr-lt:#D8F3DC;
  --rd:#8B2A2A; --rd-lt:#FFE5E5;
  --a:#A15C00; --a-lt:#FBF0E0;
  --fh:'Archivo',sans-serif; --fb:'Plus Jakarta Sans',sans-serif;
  --r:10px; --sh:0 2px 16px rgba(30,58,40,.08);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--fb);background:var(--ow);color:var(--preto);line-height:1.6;}

/* ── HEADER ── */
.hdr{background:var(--se);color:#fff;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:60px;position:sticky;top:0;z-index:200;}
.brand{display:flex;align-items:center;gap:10px;}
.bn{font-family:var(--fh);font-size:1.05rem;font-weight:700;}
.bs{font-size:.6rem;letter-spacing:.13em;text-transform:uppercase;opacity:.55;font-family:var(--fb);}
.hdr-acts{display:flex;gap:.6rem;}
.hbtn{background:transparent;color:rgba(255,255,255,.7);font-size:.72rem;font-weight:500;padding:5px 12px;border-radius:20px;border:1px solid rgba(255,255,255,.2);cursor:pointer;font-family:var(--fb);transition:all .2s;}
.hbtn:hover{background:rgba(255,255,255,.12);color:#fff;}
.hbtn.amber{background:rgba(196,113,15,.2);border-color:rgba(196,113,15,.4);color:#E8A84A;}

/* ── HERO ── */
.hero{background:var(--se);color:#fff;padding:2.5rem 2rem 2rem;position:relative;overflow:hidden;}
.hero::after{content:'';position:absolute;right:-50px;bottom:-50px;width:260px;height:260px;opacity:.04;
  background:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='100' cy='100' r='3' fill='%23fff'/%3E%3Ccircle cx='30' cy='80' r='2.5' fill='%23fff'/%3E%3Ccircle cx='170' cy='50' r='2' fill='%23fff'/%3E%3Ccircle cx='40' cy='155' r='2' fill='%23fff'/%3E%3Ccircle cx='165' cy='150' r='2.5' fill='%23fff'/%3E%3Cline x1='100' y1='100' x2='30' y2='80' stroke='%23fff' stroke-width='1'/%3E%3Cline x1='100' y1='100' x2='170' y2='50' stroke='%23fff' stroke-width='1'/%3E%3Cline x1='100' y1='100' x2='40' y2='155' stroke='%23fff' stroke-width='1'/%3E%3Cline x1='100' y1='100' x2='165' y2='150' stroke='%23fff' stroke-width='1'/%3E%3C/svg%3E") center/contain no-repeat;}
.hero-in{max-width:1200px;margin:0 auto;position:relative;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1.25rem;}
.hero-tag{display:inline-block;background:rgba(196,113,15,.2);border:1px solid rgba(196,113,15,.4);color:#E8A84A;font-size:.65rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;border-radius:20px;margin-bottom:.85rem;font-family:var(--fb);}
.hero h1{font-family:var(--fh);font-size:clamp(1.35rem,2.6vw,1.85rem);font-weight:700;letter-spacing:-.02em;margin-bottom:.3rem;}
.hero p{font-size:.82rem;opacity:.6;max-width:420px;}
.hero-kpis{display:flex;gap:.65rem;flex-wrap:wrap;}
.hkpi{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:.65rem .9rem;min-width:88px;}
.hkpi .v{font-family:var(--fh);font-size:1.4rem;font-weight:700;line-height:1;}
.hkpi .l{font-size:.63rem;opacity:.55;margin-top:.1rem;font-family:var(--fb);}
.ambar{color:#E8A84A;}

/* ── CFG BANNER ── */
.cfg-banner{background:var(--amb-lt);border-bottom:2px solid var(--ambar);padding:.65rem 2rem;cursor:pointer;display:flex;align-items:center;justify-content:space-between;}
.cfg-banner-txt{font-size:.78rem;font-weight:600;color:var(--ambar);font-family:var(--fh);}
.cfg-banner-sub{font-size:.7rem;color:#7B5500;margin-top:.1rem;font-family:var(--fb);}
.cfg-arrow{font-size:.85rem;color:var(--ambar);transition:transform .25s;}
.cfg-arrow.open{transform:rotate(180deg);}
.cfg-panel{background:#fffdf7;border-bottom:1px solid var(--brd);max-height:0;overflow:hidden;transition:max-height .4s ease;}
.cfg-panel.open{max-height:9999px;}
.cfg-inner{max-width:1200px;margin:0 auto;padding:1.5rem 2rem 2rem;}
.cfg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:.6rem;margin-top:.85rem;}
.cfg-sec{font-size:.7rem;font-weight:700;color:var(--se);text-transform:uppercase;letter-spacing:.08em;margin-top:1.25rem;margin-bottom:.6rem;border-bottom:1px solid var(--brd);padding-bottom:.35rem;font-family:var(--fh);}
.cfg-sec:first-child{margin-top:0;}
.cfg-row{background:#fff;border:1px solid var(--brd);border-radius:8px;padding:.65rem .85rem;display:flex;align-items:center;gap:.7rem;}
.cfg-lbl{font-size:.78rem;color:var(--preto);flex:1;font-family:var(--fb);}
.cfg-lbl small{display:block;font-size:.68rem;color:var(--sm);}
.cfg-inp{width:50px;text-align:center;font-family:var(--fh);font-size:.88rem;font-weight:700;color:var(--se);border:1.5px solid var(--brd);border-radius:6px;padding:.28rem;outline:none;background:var(--sf);}
.cfg-inp:focus{border-color:var(--sp);}
.bdg{display:inline-block;padding:2px 8px;border-radius:20px;font-size:.67rem;font-weight:600;font-family:var(--fb);}
.bg{background:var(--gr-lt);color:var(--gr);}
.ba{background:var(--a-lt);color:var(--a);}
.br{background:var(--rd-lt);color:var(--rd);}
.bb{background:var(--sf);color:var(--se);}
.cfg-apply{background:var(--se);color:#fff;border:none;padding:.65rem 1.35rem;border-radius:8px;font-family:var(--fh);font-size:.82rem;font-weight:600;cursor:pointer;margin-top:1.1rem;transition:background .2s;}
.cfg-apply:hover{background:var(--sp);}
.cfg-reset{background:#fff;color:var(--graf);border:1px solid var(--brd);padding:.65rem 1rem;border-radius:8px;font-family:var(--fb);font-size:.8rem;cursor:pointer;margin-top:1.1rem;margin-left:.6rem;}

/* ── TABS ── */
.tabs-wrap{background:#fff;border-bottom:1px solid var(--brd);position:sticky;top:60px;z-index:190;}
.tabs{max-width:1200px;margin:0 auto;padding:0 1.5rem;display:flex;overflow-x:auto;}
.tbtn{border:none;background:none;cursor:pointer;font-family:var(--fb);font-size:.78rem;font-weight:500;color:var(--graf);padding:.8rem .95rem;white-space:nowrap;border-bottom:2.5px solid transparent;transition:all .15s;}
.tbtn:hover{color:var(--sp);}
.tbtn.on{color:var(--se);border-bottom-color:var(--sp);}

/* ── LAYOUT ── */
.wrap{max-width:1200px;margin:0 auto;padding:1.75rem 1.5rem 5rem;}
.tp{display:none;}.tp.on{display:block;}
.sh{margin-bottom:1.1rem;}
.sh h2{font-family:var(--fh);font-size:1.25rem;font-weight:700;letter-spacing:-.02em;margin-bottom:.12rem;}
.sh p{font-size:.8rem;color:var(--sp);}

/* ── GRIDS ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-bottom:1rem;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:.85rem;margin-bottom:1rem;}
@media(max-width:860px){.g3{grid-template-columns:1fr 1fr;}.g4{grid-template-columns:1fr 1fr;}}
@media(max-width:560px){.g2{grid-template-columns:1fr;}.g3{grid-template-columns:1fr;}}

/* ── CARDS ── */
.card{background:#fff;border:1px solid var(--brd);border-radius:var(--r);padding:1rem;box-shadow:var(--sh);animation:up .3s ease both;}
@keyframes up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.card h3{font-size:.7rem;font-weight:600;color:var(--sp);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.4rem;font-family:var(--fb);}
.card .big{font-family:var(--fh);font-size:2rem;font-weight:700;color:var(--se);line-height:1;}
.card .sub{font-size:.72rem;color:var(--graf);margin-top:.15rem;}
.cc{background:#fff;border:1px solid var(--brd);border-radius:var(--r);padding:1rem 1.25rem;box-shadow:var(--sh);margin-bottom:1rem;}
.cc h3{font-size:.76rem;font-weight:600;color:var(--preto);margin-bottom:.85rem;font-family:var(--fh);}
.cc h3 .sub{font-weight:400;color:var(--sm);font-size:.72rem;}
.cw{position:relative;}

/* ── KPI BAR ── */
.kr{display:flex;align-items:center;padding:.45rem 0;border-bottom:1px solid var(--brd);}
.kr:last-child{border:none;}
.kl{font-size:.79rem;color:var(--graf);flex:1;}
.kb{width:90px;height:5px;background:var(--sc);border-radius:3px;margin:0 .55rem;flex-shrink:0;}
.kf{height:100%;border-radius:3px;}
.kv{font-size:.76rem;font-weight:700;min-width:30px;text-align:right;font-family:var(--fh);}

/* ── HEAT MAP ── */
.heat-wrap{overflow-x:auto;}
.heat-table{width:100%;border-collapse:collapse;font-size:.78rem;min-width:480px;}
.heat-table th{padding:.55rem .7rem;text-align:center;font-weight:600;font-size:.7rem;color:#fff;background:var(--se);white-space:nowrap;}
.heat-table th:first-child{text-align:left;min-width:180px;}
.heat-table td{padding:.5rem .7rem;border-bottom:1px solid var(--brd);text-align:center;vertical-align:middle;}
.heat-table td:first-child{text-align:left;background:var(--sf);font-weight:500;color:var(--preto);border-right:1px solid var(--brd);}
.heat-table tr:last-child td{border-bottom:none;}
.heat-cell{display:inline-flex;align-items:center;justify-content:center;width:100%;border-radius:5px;padding:3px 6px;font-size:.72rem;font-weight:600;font-family:var(--fh);}
.hc0{background:var(--ow);color:var(--brd);}
.hc1{background:#D1FAE5;color:#065F46;}
.hc2{background:#A7F3D0;color:#065F46;}
.hc3{background:#6EE7B7;color:#064E3B;}
.hc4{background:#34D399;color:#022C22;}
.hc5{background:#10B981;color:#fff;}

/* ── CROSS TABLE ── */
.cross-wrap{overflow-x:auto;}
.ct{width:100%;border-collapse:collapse;font-size:.78rem;}
.ct th{padding:.55rem .75rem;text-align:left;font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--sp);border-bottom:2px solid var(--brd);font-family:var(--fb);}
.ct td{padding:.6rem .75rem;border-bottom:1px solid var(--brd);color:var(--graf);vertical-align:top;}
.ct tr:last-child td{border-bottom:none;}
.ct tr:hover td{background:#fafaf8;}
.cdim{font-weight:600;color:var(--preto);}

/* ── RESP TABLE ── */
.rt{width:100%;border-collapse:collapse;font-size:.78rem;}
.rt th{background:var(--se);color:#fff;padding:.55rem .75rem;text-align:left;font-weight:500;font-size:.7rem;font-family:var(--fb);}
.rt td{padding:.5rem .75rem;border-bottom:1px solid var(--brd);color:var(--graf);vertical-align:top;}
.rt tr:hover td{background:var(--sf);}
.rt tr:last-child td{border-bottom:none;}

/* ── MODAL ── */
.mo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:300;align-items:center;justify-content:center;}
.mo.on{display:flex;}
.mdl{background:#fff;border-radius:var(--r);padding:1.5rem;max-width:500px;width:90%;box-shadow:0 16px 48px rgba(0,0,0,.18);}
.mdl h3{font-family:var(--fh);font-size:1.1rem;font-weight:700;margin-bottom:.55rem;}
.mdl p{font-size:.78rem;color:var(--graf);margin-bottom:.8rem;}
.mdl textarea{width:100%;height:130px;font-family:var(--fb);font-size:.78rem;border:1.5px solid var(--brd);border-radius:8px;padding:.6rem;outline:none;resize:vertical;}
.mdl textarea:focus{border-color:var(--sp);}
.mf{display:flex;gap:.6rem;justify-content:flex-end;margin-top:.8rem;}
.bcn{background:#fff;border:1px solid var(--brd);color:var(--graf);padding:.5rem .9rem;border-radius:7px;font-family:var(--fb);font-size:.78rem;cursor:pointer;}
.bimp{background:var(--se);color:#fff;border:none;padding:.5rem 1.1rem;border-radius:7px;font-family:var(--fb);font-size:.78rem;font-weight:500;cursor:pointer;}

/* ── EMPTY ── */
.empty{text-align:center;padding:4rem 2rem;color:var(--graf);}
.empty .ei{font-size:2rem;margin-bottom:.65rem;}
.empty h3{font-family:var(--fh);font-size:1.1rem;color:var(--preto);margin-bottom:.35rem;}
.empty p{font-size:.82rem;margin-bottom:1rem;}
.empty .cta{display:inline-block;background:var(--se);color:#fff;border-radius:8px;padding:.65rem 1.35rem;font-family:var(--fh);font-size:.82rem;font-weight:600;text-decoration:none;cursor:pointer;border:none;}

/* ── GABARITO ── */
.gab-card{background:#fff;border:1px solid var(--brd);border-radius:var(--r);padding:.9rem 1.15rem;margin-bottom:.75rem;box-shadow:var(--sh);}
.gab-card h3{font-size:.76rem;font-weight:600;color:var(--se);margin-bottom:.7rem;font-family:var(--fh);}
.gt{width:100%;border-collapse:collapse;font-size:.76rem;}
.gt th{padding:.45rem .7rem;font-size:.66rem;font-weight:600;color:var(--sp);text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid var(--brd);text-align:left;font-family:var(--fb);}
.gt td{padding:.45rem .7rem;border-bottom:1px solid var(--brd);color:var(--graf);}
.gt tr:last-child td{border-bottom:none;}

/* ── BTNS ── */
.btn-add{display:inline-flex;align-items:center;gap:.4rem;background:var(--se);color:#fff;border:none;padding:.6rem 1.1rem;border-radius:8px;font-family:var(--fb);font-size:.78rem;font-weight:500;cursor:pointer;transition:background .2s;}
.btn-add:hover{background:var(--sp);}
.btn-clr{display:inline-flex;align-items:center;gap:.4rem;background:#fff;color:var(--rd);border:1px solid var(--rd);padding:.6rem .95rem;border-radius:8px;font-family:var(--fb);font-size:.78rem;font-weight:500;cursor:pointer;}
.btn-clr:hover{background:var(--rd-lt);}
.btn-exp{display:inline-flex;align-items:center;gap:.4rem;background:#fff;color:var(--sp);border:1px solid var(--sp);padding:.6rem .95rem;border-radius:8px;font-family:var(--fb);font-size:.78rem;font-weight:500;cursor:pointer;}
.btn-exp:hover{background:var(--sf);}

/* ── NOTE ── */
.note{background:var(--amb-lt);border-left:3px solid var(--ambar);padding:.65rem .9rem;border-radius:0 8px 8px 0;font-size:.78rem;color:#7B5500;margin-bottom:1rem;font-family:var(--fb);}

.chip{display:inline-block;background:var(--sf);color:var(--sp);border:1px solid var(--sc);border-radius:20px;padding:2px 9px;font-size:.68rem;font-weight:500;margin:2px;font-family:var(--fb);}
</style>
</head>
<body>

<!-- ── HEADER ── -->
<header class="hdr">
  <div class="brand">
    <svg width="26" height="26" viewBox="0 0 40 40" fill="none">
      <circle cx="20" cy="20" r="2.8" fill="#fff"/>
      <circle cx="20" cy="20" r="4.8" stroke="#fff" stroke-width="1.1" fill="none"/>
      <circle cx="7" cy="13" r="2.1" fill="#7FA88A"/>
      <circle cx="8" cy="29" r="2.1" fill="#7FA88A"/>
      <circle cx="20" cy="5" r="1.7" fill="#7FA88A"/>
      <circle cx="33" cy="13" r="2.1" stroke="#C2D9C8" stroke-width="1.1" fill="none"/>
      <circle cx="35" cy="22" r="1.7" stroke="#C2D9C8" stroke-width="1.1" fill="none"/>
      <line x1="20" y1="20" x2="7" y2="13" stroke="#fff" stroke-width=".9" opacity=".6"/>
      <line x1="20" y1="20" x2="33" y2="13" stroke="#fff" stroke-width=".9" opacity=".6"/>
      <line x1="20" y1="20" x2="8" y2="29" stroke="#fff" stroke-width=".9" opacity=".6"/>
      <line x1="20" y1="20" x2="35" y2="22" stroke="#fff" stroke-width=".9" opacity=".6"/>
      <line x1="20" y1="20" x2="20" y2="5" stroke="#fff" stroke-width=".9" opacity=".6"/>
    </svg>
    <div><div class="bn">Nexa</div><div class="bs">Estratégia &amp; Eficiência</div></div>
  </div>
  <div class="hdr-acts">
    <button class="hbtn amber" onclick="openMo()">+ Importar respostas</button>
    <button class="hbtn" onclick="exportData()">Exportar JSON</button>
    <button class="hbtn" onclick="clearD()">Limpar dados</button>
  </div>
</header>

<!-- ── HERO ── -->
<div class="hero">
  <div class="hero-in">
    <div>
      <div class="hero-tag">Painel de análise · Uso interno Nexa</div>
      <h1>Benchmark: Modelo de remuneração<br>de escritórios jurídicos</h1>
      <p>Análise consolidada das respostas coletadas. <span id="syncIndicator" style="font-style:italic">↻ Carregando...</span></p>
      <p style="margin-top:.4rem"><button onclick="fetchFromSheets()" style="background:transparent;border:none;color:rgba(255,255,255,.5);font-size:.72rem;font-family:var(--fb);cursor:pointer;padding:0;text-decoration:underline">Atualizar agora</button></p>
    </div>
    <div class="hero-kpis">
      <div class="hkpi"><div class="v" id="st1">0</div><div class="l">Respondentes</div></div>
      <div class="hkpi"><div class="v ambar" id="st2">—</div><div class="l">Modelo híbrido</div></div>
      <div class="hkpi"><div class="v ambar" id="st3">—</div><div class="l">Usam êxito</div></div>
      <div class="hkpi"><div class="v ambar" id="st4">—</div><div class="l">Satisfação média</div></div>
      <div class="hkpi"><div class="v ambar" id="st5">—</div><div class="l">Perf. vinculada</div></div>
    </div>
  </div>
</div>

<!-- ── CONFIG PANEL ── -->
<div class="cfg-banner" onclick="toggleCfg()">
  <div>
    <div class="cfg-banner-txt">⚙ Configurar pesos e classificações do gabarito</div>
    <div class="cfg-banner-sub">Altere pontuações por resposta, limiares e rótulos. As análises se atualizam automaticamente.</div>
  </div>
  <span class="cfg-arrow" id="cfgArrow">▼</span>
</div>
<div class="cfg-panel" id="cfgPanel">
  <div class="cfg-inner">
    <div class="cfg-sec">Pontuação por dimensão e resposta (0 a 5)</div>
    <div class="note">Altere os valores numéricos para mudar o peso de cada opção no score. Clique em "Aplicar" para recalcular todas as análises.</div>
    <div class="cfg-grid" id="cfgGrid"></div>
    <div class="cfg-sec" style="margin-top:1.5rem">Limiares de maturidade</div>
    <div class="cfg-grid" id="cfgThresh"></div>
    <div>
      <button class="cfg-apply" onclick="applyConfig()">Aplicar configurações</button>
      <button class="cfg-reset" onclick="resetConfig()">Restaurar padrões</button>
    </div>
  </div>
</div>

<!-- ── TABS ── -->
<div class="tabs-wrap">
  <div class="tabs">
    <button class="tbtn on"  onclick="tab('visao',this)">Visão geral</button>
    <button class="tbtn"     onclick="tab('modelos',this)">Modelos</button>
    <button class="tbtn"     onclick="tab('exito',this)">Êxito</button>
    <button class="tbtn"     onclick="tab('performance',this)">Performance</button>
    <button class="tbtn"     onclick="tab('acordos',this)">Acordos</button>
    <button class="tbtn"     onclick="tab('satisfacao',this)">Satisfação</button>
    <button class="tbtn"     onclick="tab('governanca',this)">Governança</button>
    <button class="tbtn"     onclick="tab('respostas',this)">Respostas</button>
    <button class="tbtn"     onclick="tab('gabarito',this)">Gabarito</button>
  </div>
</div>

<div class="wrap">

<!-- ════ VISÃO GERAL ════ -->
<div class="tp on" id="tab-visao">
  <div id="empty-visao" class="empty" style="display:none">
    <div class="ei">📋</div><h3>Nenhuma resposta ainda</h3>
    <p>Importe os dados coletados pelo formulário para ver a análise.</p>
    <button class="cta" onclick="openMo()">+ Importar respostas</button>
  </div>
  <div id="content-visao">
    <div class="sh"><h2>Visão geral</h2><p>Perfil e distribuição das empresas participantes</p></div>
    <div class="g4">
      <div class="card"><h3>Respondentes</h3><div class="big" id="k1">0</div><div class="sub">empresas participantes</div></div>
