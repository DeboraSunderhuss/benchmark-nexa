.bn { font-family: var(--fh); font-size: 1.05rem; font-weight: 700; letter-spacing: -.02em; line-height: 1; }
.bs { font-size: .58rem; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; opacity: .55; }
.hdr-right { font-size: .72rem; color: rgba(255,255,255,.45); font-family: var(--fb); }

/* ── HERO ────────────────────────────────────────────────────────── */
.hero {
  background: var(--se);
  color: #fff;
  padding: 5rem 2.5rem 4rem;
  position: relative;
  overflow: hidden;
  min-height: 420px;
  display: flex; align-items: center;
}
/* animated nexo background */
.hero-bg {
  position: absolute; inset: 0;
  pointer-events: none;
}
.hero-bg canvas {
  width: 100%; height: 100%;
  opacity: .12;
}
/* left accent bar */
.hero::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 3px;
  background: linear-gradient(to bottom, transparent, var(--ambar), transparent);
}
.hero-in {
  max-width: 780px;
  position: relative;
  z-index: 1;
}
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  margin-bottom: 1.75rem;
}
.hero-eyebrow-line {
  width: 24px; height: 1px;
  background: var(--ambar);
}
.hero-eyebrow-text {
  font-size: .68rem; font-weight: 600; letter-spacing: .16em;
  text-transform: uppercase; color: var(--ambar);
  font-family: var(--fb);
}
.hero h1 {
  font-family: var(--fh);
  font-size: clamp(2rem, 4.5vw, 3.2rem);
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -.03em;
  margin-bottom: 1.5rem;
}
.hero h1 .line2 { display: block; }
.hero h1 .accent {
  color: var(--ambar);
  font-style: italic;
}
.hero-body {
  max-width: 560px;
  margin-bottom: 2.5rem;
}
.hero-body p {
  font-size: .95rem;
  line-height: 1.75;
  color: rgba(255,255,255,.72);
  margin-bottom: .85rem;
}
.hero-body p:last-child { margin-bottom: 0; }
.hero-body strong { color: #fff; font-weight: 600; }
.hero-stats {
  display: flex; gap: 2rem; flex-wrap: wrap;
}
.hero-stat {
  display: flex; flex-direction: column; gap: 2px;
}
.hero-stat .val {
  font-family: var(--fh);
  font-size: 1.6rem; font-weight: 700;
  line-height: 1;
  color: #fff;
}
.hero-stat .lbl {
  font-size: .68rem; letter-spacing: .1em;
  text-transform: uppercase; color: rgba(255,255,255,.45);
  font-family: var(--fb);
}
.hero-divider {
  width: 1px; height: 40px;
  background: rgba(255,255,255,.12);
  align-self: center;
}

/* ── PROGRESS ────────────────────────────────────────────────────── */
.prog-wrap {
  background: var(--se);
  border-bottom: 1px solid rgba(255,255,255,.07);
  padding: .6rem 2.5rem;
  position: sticky; top: 60px; z-index: 190;
  display: flex; align-items: center; gap: 1rem;
}
.prog-lbl {
  font-size: .65rem; font-weight: 600;
  color: rgba(255,255,255,.4);
  text-transform: uppercase; letter-spacing: .1em;
  font-family: var(--fb); white-space: nowrap;
}
.prog-track {
  flex: 1; height: 2px;
  background: rgba(255,255,255,.1);
  border-radius: 2px; overflow: hidden;
}
.prog-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--ambar), var(--sm));
  border-radius: 2px;
  transition: width .5s cubic-bezier(.4,0,.2,1);
}
.prog-pct {
  font-size: .7rem; font-weight: 700;
  color: rgba(255,255,255,.55);
  min-width: 32px; text-align: right;
  font-family: var(--fh);
}

/* ── CONTAINER ───────────────────────────────────────────────────── */
.container { max-width: 760px; margin: 0 auto; padding: 2.5rem 1.5rem 8rem; }

/* ── SECTION CARD ────────────────────────────────────────────────── */
.sc {
  background: #fff;
  border: 1px solid var(--brd);
  border-radius: var(--r);
  margin-bottom: 1.5rem;
  overflow: hidden;
  box-shadow: var(--sh);
  animation: up .4s cubic-bezier(.4,0,.2,1) both;
}
@keyframes up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
.sc-head {
  padding: 1.1rem 1.75rem;
  border-bottom: 1px solid var(--brd);
  display: flex; align-items: center; gap: .85rem;
  background: linear-gradient(135deg, var(--sf) 0%, #fff 100%);
}
.sc-num {
  width: 26px; height: 26px;
  background: var(--se); color: #fff;
  border-radius: 6px;
  font-size: .68rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; font-family: var(--fh);
  letter-spacing: .02em;
}
.sc-title { font-family: var(--fh); font-size: .88rem; font-weight: 700; color: var(--se); letter-spacing: -.01em; }
.sc-subtitle { font-size: .75rem; color: var(--sm); font-family: var(--fb); margin-top: 1px; }
.sc-body { padding: 1.75rem; }

/* ── QUESTION ────────────────────────────────────────────────────── */
.q { margin-bottom: 1.8rem; }
.q:last-child { margin-bottom: 0; }
.q-lbl {
  font-size: .875rem; font-weight: 600; color: var(--preto);
  margin-bottom: .65rem; line-height: 1.45;
  font-family: var(--fb);
}
.q-lbl .num { color: var(--ambar); font-family: var(--fh); font-weight: 700; margin-right: .3rem; }
.q-lbl .req { color: var(--ambar); font-size: .65rem; margin-left: 2px; vertical-align: super; }
.q-hint {
  font-size: .75rem; color: var(--sm);
  margin-bottom: .6rem; font-style: italic;
  line-height: 1.5;
}
.q-example {
  font-size: .73rem; color: var(--graf);
  background: var(--sf); border-left: 2px solid var(--sc);
  padding: .45rem .7rem; border-radius: 0 6px 6px 0;
  margin-bottom: .65rem; font-style: italic;
}
.err-msg { color: var(--rd); font-size: .72rem; margin-top: .3rem; display: none; }
.err-msg.on { display: block; }

/* ── DIVIDER ─────────────────────────────────────────────────────── */
.q-divider { height: 1px; background: var(--brd); margin: 1.5rem 0; }

/* ── INPUTS ──────────────────────────────────────────────────────── */
input[type=text], input[type=number], textarea, select {
  width: 100%;
  font-family: var(--fb); font-size: .875rem; color: var(--preto);
  background: var(--ow);
  border: 1.5px solid var(--brd);
  border-radius: 8px;
  padding: .65rem .9rem;
  outline: none;
  transition: border-color .18s, box-shadow .18s, background .18s;
  -webkit-appearance: none;
}
input:focus, textarea:focus, select:focus {
  border-color: var(--sp);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(74,116,89,.1);
}
textarea { resize: vertical; min-height: 90px; }
input[type=number] { width: 100px; }

/* ── RADIO / CHECKBOX ────────────────────────────────────────────── */
.opts { display: flex; flex-direction: column; gap: .4rem; }
.opts.two { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
.opts.three { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .4rem; }
.opt {
  display: flex; align-items: center; gap: .6rem;
  padding: .6rem .9rem;
  border: 1.5px solid var(--brd);
  border-radius: 8px;
  cursor: pointer;
  transition: all .15s;
  font-size: .845rem; color: var(--graf);
  user-select: none; font-family: var(--fb);
}
.opt:hover { border-color: var(--sp); background: var(--sf); color: var(--se); }
.opt input { display: none; }
.dot {
  width: 16px; height: 16px;
  border: 2px solid var(--brd);
  border-radius: 50%; flex-shrink: 0;
  transition: all .15s;
  display: flex; align-items: center; justify-content: center;
}
.box {
  width: 16px; height: 16px;
  border: 2px solid var(--brd);
  border-radius: 4px; flex-shrink: 0;
  transition: all .15s;
  display: flex; align-items: center; justify-content: center;
}
.opt.sel { border-color: var(--sp); background: var(--sf); color: var(--se); font-weight: 500; }
.opt.sel .dot { border-color: var(--sp); background: var(--sp); }
.opt.sel .dot::after { content:''; width:5px; height:5px; background:#fff; border-radius:50%; }
.opt.sel .box { border-color: var(--sp); background: var(--sp); }
.opt.sel .box::after { content:'✓'; color:#fff; font-size:10px; line-height:1; }
.opt-hint { font-size: .72rem; color: var(--sm); margin-top: 1px; display: block; }

/* ── LIMIT BADGE ─────────────────────────────────────────────────── */
.limit-badge {
  display: inline-block;
  background: var(--amb-lt); color: var(--ambar);
  border: 1px solid rgba(196,113,15,.2);
  font-size: .68rem; font-weight: 600;
  padding: 2px 8px; border-radius: 20px;
  margin-left: .35rem; vertical-align: middle;
  font-family: var(--fb);
}
.limit-note { font-size: .72rem; color: var(--ambar); margin-top: .3rem; display: none; }
.limit-note.on { display: block; }

/* ── SCALE ───────────────────────────────────────────────────────── */
.scale-row { display: flex; gap: .35rem; }
.scale-btn {
  flex: 1; padding: .7rem .25rem;
  border: 1.5px solid var(--brd);
  border-radius: 8px; background: var(--ow);
  cursor: pointer; text-align: center;
  font-size: .9rem; font-family: var(--fh); font-weight: 700; color: var(--graf);
  transition: all .15s;
}
.scale-btn:hover { border-color: var(--sp); color: var(--se); background: var(--sf); }
.scale-btn.sel { border-color: var(--sp); background: var(--sp); color: #fff; }
.scale-labels { display: flex; justify-content: space-between; font-size: .7rem; color: var(--sm); margin-top: .35rem; }

/* ── MATRIX ──────────────────────────────────────────────────────── */
.matrix-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: .1rem; }
.matrix {
  width: 100%; border-collapse: collapse;
  font-size: .8rem; min-width: 520px;
}
.matrix th {
  padding: .6rem .7rem;
  text-align: center;
  font-weight: 600; font-size: .72rem;
  color: #fff; background: var(--se);
  white-space: nowrap;
}
.matrix th:first-child {
  text-align: left;
  background: var(--se);
  min-width: 180px;
}
.matrix td {
  padding: .55rem .7rem;
  border-bottom: 1px solid var(--brd);
  vertical-align: middle;
}
.matrix td:first-child {
  font-weight: 500; color: var(--preto);
  background: var(--sf);
  border-right: 1px solid var(--brd);
}
.matrix tr:last-child td { border-bottom: none; }
.matrix tr:hover td { background: #fafaf8; }
.matrix tr:hover td:first-child { background: var(--sc); }
.matrix td.center { text-align: center; }
.m-check {
  width: 20px; height: 20px;
  border: 2px solid var(--brd);
  border-radius: 4px;
  cursor: pointer; margin: 0 auto;
  transition: all .15s;
  display: flex; align-items: center; justify-content: center;
}
.m-check:hover { border-color: var(--sp); background: var(--sf); }
.m-check.sel { border-color: var(--sp); background: var(--sp); }
.m-check.sel::after { content:'✓'; color:#fff; font-size:11px; line-height:1; }
.m-radio {
  width: 20px; height: 20px;
  border: 2px solid var(--brd);
  border-radius: 50%;
  cursor: pointer; margin: 0 auto;
  transition: all .15s;
  display: flex; align-items: center; justify-content: center;
}
.m-radio:hover { border-color: var(--sp); }
.m-radio.sel { border-color: var(--sp); background: var(--sp); }
.m-radio.sel::after { content:''; width:6px; height:6px; background:#fff; border-radius:50%; }
/* dropdown in matrix */
.m-select {
  width: 100%; min-width: 130px;
  font-family: var(--fb); font-size: .75rem; color: var(--preto);
  background: #fff; border: 1.5px solid var(--brd);
  border-radius: 6px; padding: .3rem .5rem; outline: none;
  cursor: pointer;
}
.m-select:focus { border-color: var(--sp); }

/* ── PCT ROW ─────────────────────────────────────────────────────── */
.pct-row {
  display: flex; align-items: center;
  gap: .75rem; margin-bottom: .5rem;
  padding: .55rem .85rem;
  background: var(--ow); border: 1.5px solid var(--brd);
  border-radius: 8px;
}
.pct-label { flex: 1; font-size: .845rem; color: var(--preto); font-family: var(--fb); font-weight: 500; }
.pct-input {
  width: 72px !important;
  text-align: center;
  font-family: var(--fh); font-weight: 700; color: var(--se);
}
.pct-unit { font-size: .8rem; color: var(--sm); font-weight: 600; flex-shrink: 0; }
.pct-total {
  display: flex; align-items: center; justify-content: flex-end;
  gap: .5rem; padding: .5rem .85rem 0;
  font-size: .78rem;
}
.pct-total .tot-lbl { color: var(--graf); }
.pct-total .tot-val { font-family: var(--fh); font-weight: 700; font-size: .9rem; color: var(--se); }
.pct-total .tot-val.over { color: var(--rd); }
.pct-total .tot-val.ok { color: var(--sp); }

/* ── CONDITIONAL ─────────────────────────────────────────────────── */
.cond {
  display: none;
  margin-top: .75rem;
  padding: 1rem 1.1rem;
  background: var(--sf);
  border-radius: 8px;
  border-left: 3px solid var(--sc);
}
.cond.on { display: block; }
.cond .q { margin-bottom: 1.2rem; }
.cond .q:last-child { margin-bottom: 0; }

/* ── LGPD CARD ───────────────────────────────────────────────────── */
.lgpd {
  background: #fff;
  border: 1px solid var(--brd);
  border-radius: var(--r);
  margin-bottom: 1.5rem;
  overflow: hidden;
  box-shadow: var(--sh);
  animation: up .4s ease both;
}
.lgpd-top {
  background: var(--se);
  padding: 1.25rem 1.75rem;
  display: flex; align-items: center; gap: 1rem;
}
.lgpd-icon {
  width: 40px; height: 40px;
  background: rgba(255,255,255,.1);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.lgpd-top-text h2 {
  font-family: var(--fh); font-size: 1rem; font-weight: 700; color: #fff;
}
.lgpd-top-text p {
  font-size: .72rem; color: rgba(255,255,255,.55); font-family: var(--fb);
  margin-top: 1px;
}
.lgpd-body { padding: 1.5rem 1.75rem; }
.lgpd-body p {
  font-size: .845rem; color: var(--graf);
  margin-bottom: .7rem; line-height: 1.7;
}
.lgpd-body p:last-of-type { margin-bottom: 0; }
.lgpd-body strong { color: var(--preto); }
.lgpd-items {
  margin: 1rem 0;
  display: flex; flex-direction: column; gap: .5rem;
}
.lgpd-item {
  display: flex; align-items: flex-start; gap: .65rem;
  font-size: .835rem; color: var(--graf); line-height: 1.6;
}
.lgpd-dot {
  width: 6px; height: 6px;
  background: var(--sm); border-radius: 50%;
  margin-top: .45rem; flex-shrink: 0;
}
.lgpd-agree {
  display: flex; align-items: flex-start; gap: .75rem;
  padding: 1rem 1.1rem;
  border: 1.5px solid var(--brd); border-radius: 8px;
  cursor: pointer; transition: all .15s; margin-top: 1.25rem;
  background: var(--ow);
}
.lgpd-agree:hover { border-color: var(--sp); background: var(--sf); }
.lgpd-agree.sel { border-color: var(--sp); background: var(--sf); }
.lgpd-agree input { display: none; }
.lgpd-chk {
  width: 20px; height: 20px;
  border: 2px solid var(--brd); border-radius: 5px;
  flex-shrink: 0; margin-top: 1px;
  transition: all .15s;
  display: flex; align-items: center; justify-content: center;
}
.lgpd-agree.sel .lgpd-chk { background: var(--sp); border-color: var(--sp); }
.lgpd-agree.sel .lgpd-chk::after { content:'✓'; color:#fff; font-size:12px; line-height:1; }
.lgpd-txt { font-size: .845rem; color: var(--preto); font-family: var(--fb); line-height: 1.6; }
.lgpd-txt strong { color: var(--se); font-weight: 600; }

/* ── SUBMIT / SUCCESS ────────────────────────────────────────────── */
.submit-area {
  background: #fff; border: 1px solid var(--brd);
  border-radius: var(--r); padding: 2rem;
  text-align: center; box-shadow: var(--sh);
}
.submit-area p { font-size: .82rem; color: var(--sm); margin-bottom: 1.25rem; max-width: 420px; margin-left: auto; margin-right: auto; }
.btn-submit {
  display: inline-flex; align-items: center; gap: .6rem;
  background: var(--se); color: #fff; border: none;
  padding: .95rem 2.5rem; border-radius: 8px;
  font-family: var(--fh); font-size: .95rem; font-weight: 700;
  cursor: pointer; transition: all .2s; letter-spacing: -.01em;
}
.btn-submit:hover { background: var(--sp); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(30,58,40,.2); }
.btn-submit:disabled { background: var(--sc); color: var(--sm); cursor: not-allowed; transform: none; box-shadow: none; }
.success-screen {
  display: none; text-align: center;
  padding: 5rem 2rem; background: #fff;
  border: 1px solid var(--brd); border-radius: var(--r);
  box-shadow: var(--sh);
}
.success-screen.on { display: block; }
.success-icon {
  width: 64px; height: 64px;
  background: var(--sf); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 1.5rem;
  border: 2px solid var(--sc);
}
.success-screen h2 { font-family: var(--fh); font-size: 1.6rem; font-weight: 700; color: var(--se); margin-bottom: .6rem; letter-spacing: -.02em; }
.success-screen p { color: var(--graf); font-size: .9rem; max-width: 460px; margin: 0 auto .5rem; line-height: 1.7; }
.success-screen .email-note { font-size: .78rem; color: var(--sm); margin-top: 1rem; }
.success-screen .email-note a { color: var(--ambar); font-weight: 600; text-decoration: none; }

@media (max-width: 620px) {
  .opts.two, .opts.three { grid-template-columns: 1fr; }
  .scale-row { gap: .2rem; }
  .scale-btn { font-size: .78rem; padding: .6rem .1rem; }
  .hero { padding: 3.5rem 1.5rem 3rem; }
  .sc-body { padding: 1.25rem; }
  .hdr { padding: 0 1.25rem; }
}
</style>
</head>
<body>

<!-- ── HEADER ──────────────────────────────────────────────────────────── -->
<header class="hdr">
  <div class="brand">
    <div class="brand-mark">
      <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="2.8" fill="#fff"/>
        <circle cx="20" cy="20" r="4.8" stroke="#fff" stroke-width="1.1" fill="none"/>
        <circle cx="7"  cy="13" r="2.1" fill="#7FA88A"/>
        <circle cx="8"  cy="29" r="2.1" fill="#7FA88A"/>
        <circle cx="20" cy="5"  r="1.7" fill="#7FA88A"/>
        <circle cx="33" cy="13" r="2.1" stroke="#C2D9C8" stroke-width="1.1" fill="none"/>
        <circle cx="35" cy="22" r="1.7" stroke="#C2D9C8" stroke-width="1.1" fill="none"/>
        <circle cx="25" cy="34" r="1.7" stroke="#C2D9C8" stroke-width="1.1" fill="none"/>
        <line x1="20" y1="20" x2="7"  y2="13" stroke="#fff" stroke-width=".9" opacity=".6"/>
        <line x1="20" y1="20" x2="33" y2="13" stroke="#fff" stroke-width=".9" opacity=".6"/>
